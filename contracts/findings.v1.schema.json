{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://postplay.local/contracts/findings.v1",
  "type": "object", "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "1" },
    "policy_version": { "const": "1" },
    "session_id": { "$ref": "https://postplay.local/contracts/session.v1#/properties/session_id" },
    "preparation_id": { "$ref": "https://postplay.local/contracts/session.v1#/properties/session_id" },
    "created_at": { "type": "string", "maxLength": 32 },
    "status": { "enum": ["analyzed_with_findings", "analyzed_no_findings", "needs_review"] },
    "analysis": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "model": { "const": "muse-spark-1.3" }, "prompt_version": { "const": "1" }, "schema_version": { "const": "1" },
        "started_at": { "type": "string", "maxLength": 32 }, "completed_at": { "type": "string", "maxLength": 32 },
        "response_id": { "type": ["string", "null"], "maxLength": 200 },
        "usage": { "type": ["object", "null"], "additionalProperties": true },
        "cost_usd": { "type": ["number", "null"], "minimum": 0 },
        "cleanup_status": { "enum": ["deleted", "delete_failed", "delete_unconfirmed", "upload_not_confirmed", "not_uploaded"] }
      },
      "required": ["model", "prompt_version", "schema_version", "started_at", "completed_at", "response_id", "usage", "cost_usd", "cleanup_status"]
    },
    "provenance": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "source_manifest_sha256": { "$ref": "#/$defs/hash" }, "source_events_sha256": { "$ref": "#/$defs/hash" }, "source_video_sha256": { "$ref": "#/$defs/hash" },
        "preparation_sha256": { "$ref": "#/$defs/hash" }, "context_sha256": { "$ref": "#/$defs/hash" }, "clip_sha256": { "$ref": "#/$defs/hash" },
        "response_sha256": { "$ref": "#/$defs/hash" }, "proposal_sha256": { "$ref": "#/$defs/hash" }, "request_sha256": { "$ref": "#/$defs/hash" },
        "stages_sha256": { "$ref": "#/$defs/hash" },
        "system_sha256": { "$ref": "#/$defs/hash" }, "user_template_sha256": { "$ref": "#/$defs/hash" }, "result_schema_sha256": { "$ref": "#/$defs/hash" },
        "video_path": { "type": "string", "pattern": "^preparations/[0-9a-f-]{36}/clip\\.mp4$" },
        "events_path": { "const": "events.jsonl" }
      },
      "required": ["source_manifest_sha256", "source_events_sha256", "source_video_sha256", "preparation_sha256", "context_sha256", "clip_sha256", "response_sha256", "proposal_sha256", "request_sha256", "stages_sha256", "system_sha256", "user_template_sha256", "result_schema_sha256", "video_path", "events_path"]
    },
    "timing": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "source_start_ms": { "type": "number", "minimum": 0 }, "clip_duration_ms": { "type": "integer", "minimum": 1, "maximum": 120000 },
        "synchronization": { "$ref": "https://postplay.local/contracts/analysis-input.v1#/properties/session/properties/synchronization" }
      },
      "required": ["source_start_ms", "clip_duration_ms", "synchronization"]
    },
    "coverage_summary": { "type": "string", "minLength": 1 },
    "limitations": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "findings": { "type": "array", "items": { "$ref": "#/$defs/candidate" } },
    "quarantined": { "type": "array", "items": { "$ref": "#/$defs/candidate" } },
    "evidence_snapshots": {
      "type": "array", "items": {
        "type": "object", "additionalProperties": false,
        "properties": { "event": { "$ref": "https://postplay.local/contracts/event.v1" }, "clip_ms": { "type": "integer", "minimum": 0 } },
        "required": ["event", "clip_ms"]
      }
    },
    "registrations": { "type": "array", "items": { "$ref": "https://postplay.local/contracts/session.v1#/properties/registrations/items" } }
  },
  "required": ["schema_version", "policy_version", "session_id", "preparation_id", "created_at", "status", "analysis", "provenance", "timing", "coverage_summary", "limitations", "findings", "quarantined", "evidence_snapshots", "registrations"],
  "$defs": {
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "candidate": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "model_claim": { "$ref": "https://postplay.local/contracts/muse-result.v1#/properties/findings/items" },
        "issues": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["model_text_unverified", "visual_claim_unverified", "expected_behavior_inferred", "observed_precedent_unverified", "suspected_softlock_only", "high_certainty_requires_review", "unsupported_evidence_values", "coverage_incomplete", "synchronization_uncertainty"] } }
      },
      "required": ["model_claim", "issues"]
    }
  }
}
