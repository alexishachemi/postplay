{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://postplay.local/contracts/session.v1",
  "type": "object", "additionalProperties": false,
  "$defs": {
    "counter": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "path": { "type": "string", "minLength": 1, "maxLength": 512 },
    "source": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^src-[1-9][0-9]*$" },
        "label": { "type": "string", "minLength": 1, "maxLength": 256 },
        "node_path": { "anyOf": [{ "$ref": "#/$defs/path" }, { "type": "null" }] }
      },
      "required": ["id", "label", "node_path"]
    }
  },
  "properties": {
    "schema_version": { "const": "1" },
    "session_id": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "project": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,128}$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 256 },
        "scene": { "$ref": "#/$defs/path" }
      },
      "required": ["id", "name", "scene"]
    },
    "godot_version": { "type": "string", "minLength": 1, "maxLength": 128 },
    "status": { "enum": ["recording", "complete", "incomplete"] },
    "started_at_utc": { "type": "string", "maxLength": 32 },
    "ended_at_utc": { "type": ["string", "null"], "maxLength": 32 },
    "capture": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "mode": { "enum": ["movie_maker", "external"] },
        "video_path": { "anyOf": [{ "$ref": "#/$defs/path" }, { "type": "null" }] },
        "format": { "enum": ["avi", "ogv", "mp4"] },
        "fps": { "type": "number", "minimum": 1, "maximum": 240 },
        "width": { "type": "integer", "minimum": 1, "maximum": 16384 },
        "height": { "type": "integer", "minimum": 1, "maximum": 16384 },
        "duration_ms": { "anyOf": [{ "$ref": "#/$defs/counter" }, { "type": "null" }] },
        "collision_debug": { "type": "boolean" }
      },
      "required": ["mode", "video_path", "format", "fps", "width", "height", "duration_ms", "collision_debug"]
    },
    "telemetry": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "path": { "const": "events.jsonl" },
        "event_count": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "truncated": { "type": "boolean" }
      },
      "required": ["path", "event_count", "truncated"]
    },
    "synchronization": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "status": { "enum": ["unknown", "approximate", "verified"] },
        "estimated_error_ms": { "anyOf": [{ "$ref": "#/$defs/counter" }, { "type": "null" }] },
        "anchor": {
          "anyOf": [
            { "type": "null" },
            {
              "type": "object", "additionalProperties": false,
              "properties": {
                "event_id": { "type": "string", "pattern": "^evt-[1-9][0-9]*$" },
                "clock": { "enum": ["process_frame", "simulation_ms", "wall_elapsed_ms"] },
                "recorded_value": { "type": "number", "minimum": 0, "maximum": 9007199254740991 },
                "video_ms": { "$ref": "#/$defs/counter" }
              },
              "required": ["event_id", "clock", "recorded_value", "video_ms"]
            }
          ]
        },
        "notes": { "type": "array", "maxItems": 16, "items": { "type": "string", "maxLength": 1024 } }
      },
      "required": ["status", "estimated_error_ms", "anchor", "notes"]
    },
    "registrations": {
      "type": "array", "maxItems": 128,
      "items": {
        "type": "object", "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^reg-[1-9][0-9]*$" },
          "kind": { "enum": ["signal", "property", "player", "bounds", "progression", "annotation"] },
          "source": { "$ref": "#/$defs/source" },
          "description": { "type": "string", "maxLength": 1024 },
          "expected_behavior": { "type": ["string", "null"], "maxLength": 1024 }
        },
        "required": ["id", "kind", "source", "description", "expected_behavior"]
      }
    }
  },
  "required": ["schema_version", "session_id", "project", "godot_version", "status", "started_at_utc", "ended_at_utc", "capture", "telemetry", "synchronization", "registrations"]
}
