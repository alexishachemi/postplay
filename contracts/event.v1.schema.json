{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://postplay.local/contracts/event.v1",
  "type": "object", "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "1" },
    "session_id": { "$ref": "https://postplay.local/contracts/session.v1#/properties/session_id" },
    "id": { "type": "string", "pattern": "^evt-[1-9][0-9]*$" },
    "sequence": { "type": "integer", "minimum": 1, "maximum": 10000 },
    "kind": { "enum": ["lifecycle", "signal", "property", "input", "position", "annotation", "progression"] },
    "time": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "wall_elapsed_ms": { "$ref": "https://postplay.local/contracts/session.v1#/$defs/counter" },
        "simulation_ms": { "type": "number", "minimum": 0, "maximum": 9007199254740991 },
        "process_frame": { "anyOf": [{ "$ref": "https://postplay.local/contracts/session.v1#/$defs/counter" }, { "type": "null" }] },
        "physics_frame": { "anyOf": [{ "$ref": "https://postplay.local/contracts/session.v1#/$defs/counter" }, { "type": "null" }] }
      },
      "required": ["wall_elapsed_ms", "simulation_ms", "process_frame", "physics_frame"]
    },
    "registration_id": { "type": ["string", "null"], "pattern": "^reg-[1-9][0-9]*$" },
    "source": { "$ref": "https://postplay.local/contracts/session.v1#/$defs/source" },
    "label": { "type": "string", "minLength": 1, "maxLength": 256 },
    "payload": { "$ref": "https://postplay.local/contracts/safe-value.v1" }
  },
  "required": ["schema_version", "session_id", "id", "sequence", "kind", "time", "registration_id", "source", "label", "payload"]
}
