{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PostPlay normalized Muse input context v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "type": "string",
      "const": "1"
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "session_id": {
          "type": "string"
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0
        },
        "video_window": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "start_ms": {
              "type": "integer",
              "minimum": 0
            },
            "end_ms": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "start_ms",
            "end_ms"
          ]
        },
        "synchronization": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "verified",
                "approximate",
                "unknown"
              ]
            },
            "estimated_error_ms": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            }
          },
          "required": [
            "status",
            "estimated_error_ms"
          ]
        },
        "recording_notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "session_id",
        "duration_ms",
        "video_window",
        "synchronization",
        "recording_notes"
      ]
    },
    "registrations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "signal",
              "property",
              "player",
              "bounds",
              "progression",
              "annotation"
            ]
          },
          "source_label": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "expected_behavior": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "kind",
          "source_label",
          "description",
          "expected_behavior"
        ]
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "t_ms": {
            "type": "integer",
            "minimum": 0
          },
          "kind": {
            "type": "string",
            "enum": [
              "signal",
              "property",
              "input",
              "position",
              "annotation",
              "progression"
            ]
          },
          "registration_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_label": {
            "type": "string"
          },
          "payload": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "required": [
          "id",
          "t_ms",
          "kind",
          "registration_id",
          "source_label",
          "payload"
        ]
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "total_events": {
          "type": "integer",
          "minimum": 0
        },
        "included_events": {
          "type": "integer",
          "minimum": 0
        },
        "truncated": {
          "type": "boolean"
        },
        "omissions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "total_events",
        "included_events",
        "truncated",
        "omissions"
      ]
    }
  },
  "required": [
    "contract_version",
    "session",
    "registrations",
    "events",
    "coverage"
  ]
}
