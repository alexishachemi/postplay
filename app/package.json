{
  "name": "postplay",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "test": "node --test tests/*.test.ts",
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev --host 127.0.0.1",
    "check": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build",
    "start": "HOST=127.0.0.1 node dist/server/entry.mjs"
  },
  "dependencies": {
    "@astrojs/node": "11.1.9",
    "@tailwindcss/vite": "4.3.3",
    "ajv": "8.20.0",
    "astro": "7.4.4",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@types/node": "24.19.2",
    "typescript": "6.0.3"
  }
}
