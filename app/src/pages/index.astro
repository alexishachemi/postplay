---
import '../styles/global.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Local gameplay recording and evidence review." />
    <title>PostPlay</title>
  </head>
  <body class="min-h-screen bg-slate-950 text-slate-100">
    <main class="mx-auto max-w-3xl px-6 py-20">
      <p class="text-sm tracking-widest text-teal-300">POSTPLAY</p>
      <h1 class="mt-4 text-4xl font-semibold">Review what happened.</h1>
      <p class="mt-4 text-lg text-slate-300">Record gameplay, analyze a session, and inspect the evidence.</p>
      <section class="mt-10 rounded-xl border border-slate-700 p-6" aria-labelledby="status">
        <h2 id="status" class="text-xl font-medium">Session review is coming</h2>
        <p class="mt-3 text-slate-300">This is the initial local application shell. Recording, session import, and analysis are still in development.</p>
        <p class="mt-3 text-slate-300">No gameplay or telemetry has been uploaded.</p>
      </section>
    </main>
  </body>
</html>
